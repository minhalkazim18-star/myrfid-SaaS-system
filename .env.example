APP_ENV=production
APP_URL=https://example.edu.my
APP_KEY=replace-with-at-least-32-random-characters
TRUST_PROXY_HEADERS=0
SESSION_IDLE_TIMEOUT=7200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=myrfid
DB_USER=myrfid_app
DB_PASSWORD=replace-with-a-strong-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.edu.my/google-login.php

# Per-device keys are generated by an administrator in Tetapan Sistem.
# Temporary single-school compatibility only; leave disabled after migration.
RFID_ALLOW_LEGACY_GLOBAL_KEY=0
RFID_LEGACY_SCHOOL_ID=
RFID_API_KEY=
